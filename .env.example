# Required for AI synthesis (without this, mock reports are generated)
ANTHROPIC_API_KEY=

# Required for Bright Data web scraping
BD_API_KEY=
BD_CUSTOMER_ID=

# Bright Data Zone Names (optional overrides — defaults shown)
# Configure these after provisioning zones in BD dashboard
BD_ZONE_UNLOCKER=web_unlocker1
BD_ZONE_SERP=serp_api1
BD_ZONE_BROWSER=scraping_browser1
BD_ZONE_SCRAPER=web_scraper1

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://ui-beta-green.vercel.app

# Server port (Railway sets this automatically)
PORT=3001
